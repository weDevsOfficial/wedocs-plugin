{
  "name": "wedocs_e2e_automation",
  "version": "1.0.0",
  "description": "End-to-end tests for weDocs (Free)",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "CI=false pnpm exec playwright test --headed",
    "test:ci": "pnpm exec playwright test",
    "env:start": "pnpm exec wp-env start",
    "env:stop": "pnpm exec wp-env stop",
    "env:destroy": "pnpm exec wp-env destroy",
    "install:browsers": "pnpm exec playwright install chromium",
    "merge-reports": "pnpm exec playwright merge-reports --reporter=html ./blob-report"
  },
  "keywords": [ "playwright", "e2e", "wordpress", "wedevs", "wedocs" ],
  "author": "weDevs QA",
  "license": "MIT",
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@wordpress/env": "^10.36.0",
    "dotenv": "^17.2.3"
  }
}
